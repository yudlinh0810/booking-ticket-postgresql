{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "es6",
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"]
    },

    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types", "./src/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
