{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "es6",
    "skipLibCheck": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
